# Copy to .env for local development. Replace placeholders; blank values are intentionally ignored.
# Never commit .env or put backend secrets in web/.env.local / VITE_* variables.

# Server and storage
PORT=
LUMINA_DATA=
LUMINA_ASSETS=
LUMINA_TOKEN=
LUMINA_FILE_SIGNING_KEY=
LUMINA_ALLOWED_ORIGINS=http://localhost:5173
FFMPEG_PATH=
FFPROBE_PATH=

# Supabase Auth and exclusive owner bootstrap
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
LUMINA_SUPER_ADMIN_USER_ID=
LUMINA_AUTH_AUDIT_SALT=
REQUIRE_SUPABASE_AUTH=false

# Hosted PostgreSQL. Leave both blank for local SQLite.
LUMINA_DATABASE_URL=
DATABASE_URL=
REQUIRE_POSTGRES=false

# AI providers (at least one is needed for AI-assisted production steps)
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Stock footage (optional; Wikimedia Commons fallback is available)
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Publishing OAuth and short-lived external media URLs
LUMINA_PUBLIC_URL=
LUMINA_FRONTEND_URL=
LUMINA_OAUTH_ENCRYPTION_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Resend email notifications
RESEND_API_KEY=
RESEND_FROM_EMAIL=
